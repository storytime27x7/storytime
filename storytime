<script>

const $ = id => document.getElementById(id);

const storyInput = $("storyInput");
const storyScreen = $("storyScreen");
const container = $("storyScreenContainer");

const startBtn = $("startBtn");
const pauseBtn = $("pauseBtn");
const resumeBtn = $("resumeBtn");
const resetBtn = $("resetBtn");

const recordBtn = $("recordBtn");
const recordVideoBtn = $("recordVideoBtn");
const stopRecordBtn = $("stopRecordBtn");

const downloadTextBtn = $("downloadTextBtn");

const languageSelect = $("languageSelect");
const genderSelect = $("genderSelect");
const voiceSelect = $("voiceSelect");

const speed = $("speed");
const pitch = $("pitch");

const speedValue = $("speedValue");
const pitchValue = $("pitchValue");

const bgColor = $("bgColor");
const bgImage = $("bgImage");

const cornerUpload = $("cornerUpload");
const cornerImage = $("cornerImage");

const musicUpload = $("musicUpload");
const musicPlayer = $("musicPlayer");
const musicVolume = $("musicVolume");

const statusEl = $("status");
const voiceInfo = $("voiceInfo");
const recordingDot = $("recordingDot");


let voices = [];
let filteredVoices = [];

let utterance = null;

let paused = false;

let animationId = null;

let mediaRecorder = null;
let recordedChunks = [];

let captureStream = null;

let recordingMode = null;

let musicURL = null;


/* =========================
   STATUS
========================= */

function status(text){
  statusEl.textContent = text;
}


/* =========================
   VOICE SYSTEM
========================= */

function loadVoices(){

  voices = speechSynthesis.getVoices();

  filterVoices();

}

function detectGender(voice){

  const n = (
    voice.name +
    " " +
    voice.voiceURI
  ).toLowerCase();

  const femaleWords = [
    "female",
    "woman",
    "girl",
    "zira",
    "samantha",
    "susan",
    "karen",
    "moira",
    "veena",
    "heera",
    "swara",
    "neerja"
  ];

  const maleWords = [
    "male",
    "man",
    "boy",
    "david",
    "mark",
    "daniel",
    "ravi",
    "hemant",
    "madhur",
    "rishi"
  ];

  if(femaleWords.some(x => n.includes(x))){
    return "female";
  }

  if(maleWords.some(x => n.includes(x))){
    return "male";
  }

  return "unknown";
}


function filterVoices(){

  const lang = languageSelect.value;

  const gender = genderSelect.value;

  filteredVoices = voices.filter(v => {

    const voiceLang =
      (v.lang || "").toLowerCase();

    const languageOK =
      lang === "all" ||
      voiceLang.startsWith(lang);

    const detectedGender =
      detectGender(v);

    const genderOK =
      gender === "all" ||
      detectedGender === gender;

    return languageOK && genderOK;

  });

  voiceSelect.innerHTML = "";

  filteredVoices.forEach((voice,index)=>{

    const option =
      document.createElement("option");

    const gender =
      detectGender(voice);

    option.value = index;

    option.textContent =
      voice.name +
      " (" +
      voice.lang +
      ") [" +
      gender +
      "]";

    voiceSelect.appendChild(option);

  });

  if(filteredVoices.length){

    voiceSelect.selectedIndex = 0;

    updateVoiceInfo();

  }else{

    const option =
      document.createElement("option");

    option.textContent =
      "इस filter में कोई voice उपलब्ध नहीं";

    voiceSelect.appendChild(option);

    voiceInfo.textContent =
      "इस भाषा/gender की voice आपके browser में उपलब्ध नहीं है।";

  }

}


function updateVoiceInfo(){

  const voice =
    filteredVoices[
      Number(voiceSelect.value)
    ];

  if(!voice){

    voiceInfo.textContent =
      "Voice उपलब्ध नहीं";

    return;

  }

  voiceInfo.innerHTML =
    "Selected Voice: " +
    "<span class='badge'>" +
    voice.name +
    "</span> " +
    "<span class='badge'>" +
    voice.lang +
    "</span> " +
    "<span class='badge'>" +
    detectGender(voice) +
    "</span>";

}


speechSynthesis.onvoiceschanged =
  loadVoices;

loadVoices();

languageSelect.addEventListener(
  "change",
  filterVoices
);

genderSelect.addEventListener(
  "change",
  filterVoices
);

voiceSelect.addEventListener(
  "change",
  updateVoiceInfo
);


/* =========================
   SPEED / PITCH
========================= */

speed.addEventListener(
  "input",
  ()=>{
    speedValue.textContent =
      Number(speed.value).toFixed(1);
  }
);

pitch.addEventListener(
  "input",
  ()=>{
    pitchValue.textContent =
      Number(pitch.value).toFixed(1);
  }
);


/* =========================
   STORY PLAY
========================= */

function startStory(){

  const text =
    storyInput.value.trim();

  if(!text){

    alert("पहले कहानी लिखें");

    return;

  }

  speechSynthesis.cancel();

  storyScreen.textContent =
    text;

  storyScreen.scrollTop = 0;

  paused = false;

  const voice =
    filteredVoices[
      Number(voiceSelect.value)
    ];

  utterance =
    new SpeechSynthesisUtterance(text);

  utterance.rate =
    Number(speed.value);

  utterance.pitch =
    Number(pitch.value);

  if(voice){

    utterance.voice =
      voice;

    utterance.lang =
      voice.lang;

  }

  utterance.onstart = ()=>{
    status("Voice चल रही है...");
  };

  utterance.onend = ()=>{
    status("Story finished");
  };

  utterance.onerror = ()=>{
    status("Voice error");
  };

  speechSynthesis.speak(
    utterance
  );

  if(musicPlayer.src){

    musicPlayer.volume =
      Number(musicVolume.value);

    musicPlayer.play()
      .catch(()=>{});

  }

  startScroll();

  startBtn.disabled = true;

  pauseBtn.disabled = false;

  resumeBtn.disabled = true;

  resetBtn.disabled = false;

}


startBtn.addEventListener(
  "click",
  startStory
);


/* =========================
   SCROLL
========================= */

function startScroll(){

  cancelAnimationFrame(animationId);

  function loop(){

    if(!paused){

      storyScreen.scrollTop += 0.7;

    }

    if(
      storyScreen.scrollTop <
      storyScreen.scrollHeight -
      storyScreen.clientHeight
    ){

      animationId =
        requestAnimationFrame(loop);

    }

  }

  animationId =
    requestAnimationFrame(loop);

}


/* =========================
   PAUSE
========================= */

pauseBtn.addEventListener(
  "click",
  ()=>{

    paused = true;

    speechSynthesis.pause();

    musicPlayer.pause();

    pauseBtn.disabled = true;

    resumeBtn.disabled = false;

    status("Paused");

  }
);


/* =========================
   RESUME
========================= */

resumeBtn.addEventListener(
  "click",
  ()=>{

    paused = false;

    speechSynthesis.resume();

    if(musicPlayer.src){

      musicPlayer.play()
        .catch(()=>{});

    }

    startScroll();

    pauseBtn.disabled = false;

    resumeBtn.disabled = true;

    status("Resumed");

  }
);


/* =========================
   RESET
========================= */

resetBtn.addEventListener(
  "click",
  ()=>{

    speechSynthesis.cancel();

    cancelAnimationFrame(
      animationId
    );

    paused = false;

    storyScreen.textContent = "";

    storyScreen.scrollTop = 0;

    musicPlayer.pause();

    musicPlayer.currentTime = 0;

    startBtn.disabled = false;

    pauseBtn.disabled = true;

    resumeBtn.disabled = true;

    resetBtn.disabled = true;

    status("Ready");

  }
);


/* =========================
   BACKGROUND
========================= */

bgColor.addEventListener(
  "input",
  ()=>{

    container.style.background =
      bgColor.value;

  }
);


bgImage.addEventListener(
  "change",
  e=>{

    const file =
      e.target.files[0];

    if(!file) return;

    const reader =
      new FileReader();

    reader.onload =
      ev => {

        container.style.background =
          "url('" +
          ev.target.result +
          "') center/cover no-repeat";

      };

    reader.readAsDataURL(file);

  }
);


/* =========================
   CORNER IMAGE
========================= */

cornerUpload.addEventListener(
  "change",
  e=>{

    const file =
      e.target.files[0];

    if(!file) return;

    const reader =
      new FileReader();

    reader.onload =
      ev => {

        cornerImage.src =
          ev.target.result;

        cornerImage.style.display =
          "block";

      };

    reader.readAsDataURL(file);

  }
);


/* =========================
   MUSIC
========================= */

musicUpload.addEventListener(
  "change",
  e=>{

    const file =
      e.target.files[0];

    if(!file) return;

    if(musicURL){

      URL.revokeObjectURL(
        musicURL
      );

    }

    musicURL =
      URL.createObjectURL(file);

    musicPlayer.src =
      musicURL;

    musicPlayer.volume =
      Number(musicVolume.value);

    status("Music loaded");

  }
);


musicVolume.addEventListener(
  "input",
  ()=>{
    musicPlayer.volume =
      Number(musicVolume.value);
  }
);


/* =========================
   DOWNLOAD TEXT
========================= */

downloadTextBtn.addEventListener(
  "click",
  ()=>{

    const blob =
      new Blob(
        [storyInput.value],
        {
          type:"text/plain;charset=utf-8"
        }
      );

    const url =
      URL.createObjectURL(blob);

    const a =
      document.createElement("a");

    a.href = url;

    a.download =
      "MyStory.txt";

    a.click();

    URL.revokeObjectURL(url);

